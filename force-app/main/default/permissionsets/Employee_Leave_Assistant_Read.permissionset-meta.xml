<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Read-only access for the Employee Leave Assistant. Grants read on Employee Leave records and their fields, plus access to run the read-only leave retrieval flow. No create/edit/delete.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Employee Leave Assistant Read</label>
    <objectPermissions>
        <object>Employee_Leave__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <fieldPermissions>
        <field>Employee_Leave__c.Employee__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Employee_Leave__c.Leave_Type__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Employee_Leave__c.Status__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Employee_Leave__c.Start_Date__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Employee_Leave__c.End_Date__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Employee_Leave__c.Reason__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Employee_Leave__c.Total_Days__c</field>
        <editable>false</editable>
        <readable>true</readable>
    </fieldPermissions>
    <flowAccesses>
        <enabled>true</enabled>
        <flow>SUB_Get_My_Leave_Records</flow>
    </flowAccesses>
</PermissionSet>
